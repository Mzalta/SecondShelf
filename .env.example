# SecondShelf Environment Variables Template
# Copy this file to .env and fill in your actual values

# Application Configuration
APP_NAME=SecondShelf
APP_ENV=development
APP_URL=http://localhost:8000

# API Keys (if you add external services in the future)
# API_KEY=your_api_key_here
# EMAIL_SERVICE_KEY=your_email_service_key_here

# Feature Flags
# ENABLE_ANALYTICS=false
# ENABLE_EMAIL_NOTIFICATIONS=false

# Storage Configuration
# STORAGE_TYPE=localStorage
# STORAGE_PREFIX=secondShelf_

# Contact/Support Information
# SUPPORT_EMAIL=support@example.com
# CONTACT_PHONE=your_phone_here
